# API runtime
API_HOST=0.0.0.0
API_PORT=14000
OUTPUT_PREFIX=single-ra

ENABLE_ADDRESS_FALLBACK=true
ENABLE_INDUSTRY_FALLBACK=true


# AWS / S3
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_VHOST=
RABBITMQ_EXCHANGE=
RABBITMQ_QUEUE=
RABBITMQ_ROUTING_KEY=


# Worker tuning
WORKER_CONCURRENCY=4
BROWSER_POOL_SIZE=4
ENABLE_VERBOSE_ROW_LOGS=true

# AI/Search providers
GEMINI_API_KEY=
SERPWOW_API_KEY=
# Massive proxy (raw credentials — get_proxy_config passes them unencoded to Playwright)
MASSIVE_USER=
MASSIVE_PASS=
MASSIVE_PROXY_HOST=network.joinmassive.com
MASSIVE_PROXY_PORT=65535
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120 Safari/537.36

# Optional Gemini cost settings (used by app.py helpers)
GEMINI_INPUT_USD_PER_1M_TOKENS=0.10
GEMINI_OUTPUT_USD_PER_1M_TOKENS=0.40
# Optional Gemini Batch cost settings (override if batch pricing differs)
GEMINI_BATCH_INPUT_USD_PER_1M_TOKENS=0.10
GEMINI_BATCH_OUTPUT_USD_PER_1M_TOKENS=0.40
# Massive tiered pricing (USD per 1000 requests)
MASSIVE_MONTHLY_REQUESTS_OFFSET=0
MASSIVE_TIER1_USD_PER_1000=0.2
MASSIVE_TIER2_USD_PER_1000=0.185
MASSIVE_TIER3_USD_PER_1000=0.15
MASSIVE_TIER1_LIMIT_REQUESTS=9000000
MASSIVE_TIER2_LIMIT_REQUESTS=14000000
MASSIVE_TIER3_LIMIT_REQUESTS=20000000
SERPWOW_USD_PER_SEARCH=0.00035
SERPWOW_USD_PER_REQUEST=0.00035

SEARCH_FETCH_CONCURRENCY=5
SEARCH_FETCH_ATTEMPTS=5
SEARCH_FETCH_CONNECT_TIMEOUT_SEC=20
SEARCH_FETCH_READ_TIMEOUT_SEC=45
SEARCH_FETCH_POOL_TIMEOUT_SEC=25

# Gemini batch post-processing (file-level)
ENABLE_GEMINI_BATCH_POSTPROCESS=true
GEMINI_BATCH_MODEL=gemini-2.5-flash-lite
GEMINI_BATCH_POLL_SEC=15
GEMINI_BATCH_TIMEOUT_SEC=1800

# Gemini URL/city-state reasoning switches
ENABLE_FINAL_URL_GEMINI=true
ENABLE_GMAPS_FALLBACK=true

# Worker/S3 stability knobs
WORKER_JOB_TIMEOUT_SEC=1800
PROCESSING_STALE_TIMEOUT_SEC=1500
ORPHAN_UPLOAD_FINALIZE_TIMEOUT_SEC=1800
ENABLE_ORPHAN_UPLOAD_FINALIZER=false
ENABLE_STALE_PROCESSING_FINALIZER=false
S3_CONNECT_TIMEOUT_SEC=15
S3_READ_TIMEOUT_SEC=90
S3_MAX_RETRIES=3

# ── AI Mode (scrape.do Google AI Mode + LLM cleanup) ──
# scrape.do (Phase 1)
SCRAPEDO_TOKEN=
SCRAPEDO_BATCH_SIZE=10
SCRAPEDO_TIMEOUT_SECONDS=90
SCRAPEDO_MAX_RETRIES=2
SCRAPEDO_MAX_QUERY_CHARS=6000
# Optional scrape.do locale/render knobs:
SCRAPEDO_DEVICE=
SCRAPEDO_HL=
SCRAPEDO_GL=
SCRAPEDO_GOOGLE_DOMAIN=
SCRAPEDO_SAFE=
SCRAPEDO_INCLUDE_HTML=false
# AI Mode LLM cleanup (Phase 2). Provider: gemini (reuses GEMINI_API_KEY/GEMINI_MODEL above) or openai.
AI_MODE_LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120

# --- AI Mode LLM cleanup (two-phase) ---
AI_MODE_LLM_BATCH=false        # false = sync cleanup via AI_MODE_LLM_PROVIDER; true = Gemini Batch API (Gemini-only)
SCRAPEDO_CONCURRENCY=5         # parallel scrape.do workers in Phase 1; raise toward the ~100 scrape.do cap
GEMINI_BATCH_SHARD_SIZE=5000   # requests per Gemini batch job
GEMINI_BATCH_MAX_INFLIGHT=5    # max concurrent Gemini batch jobs in flight
AI_MODE_BATCH_POLL_SEC=15      # poll interval for AI Mode Gemini batch jobs
AI_MODE_BATCH_TIMEOUT_SEC=172800  # per-run wait cap for AI Mode batch (48h = Gemini hard expiry); separate from SerpWow's GEMINI_BATCH_TIMEOUT_SEC

