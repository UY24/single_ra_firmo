# =====================================================================
# website_url_finder — environment configuration
# Copy to .env and fill the REQUIRED section first.
# Every key below is actually read by backend/ code (audited 2026-06).
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# 1. REQUIRED — core
# ─────────────────────────────────────────────────────────────────────
# HTTP bind address + port for the FastAPI app (UI at /app). Optional; defaults 0.0.0.0:11500.
API_HOST=0.0.0.0
API_PORT=8080
# Uvicorn dev knobs (only used when launching via `python -m app.main` / run.py).
# Optional. API_RELOAD=true enables auto-reload on code change; default false.
API_RELOAD=false
UVICORN_LOG_LEVEL=info

# scrape.do API token — REQUIRED for AI Mode (ai_bulk / ai_deep Phase 1 scraping).
SCRAPEDO_TOKEN=

# REQUIRED. Gemini is the only LLM provider (AI Mode cleanup + SerpWow Gemini helpers).
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# 2. Supabase (company/run tracking) — REQUIRED for the UI workflows
# ─────────────────────────────────────────────────────────────────────
# SUPABASE_URL must be the BARE project URL, e.g. https://xyz.supabase.co
# NOT the postgres connection string (postgresql://...:5432/...).
SUPABASE_URL=
# The service_role secret (~200+ chars JWT) from Project Settings → API.
# Server-side only — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────
# 3. AI Mode (scrape.do Google AI Mode + LLM cleanup)
# ─────────────────────────────────────────────────────────────────────

# ── 3a. Batch sizes — entities per scrape.do prompt, tune per use case ──
# AI Mode 1 — Bulk (ai_bulk): broad search, get as much as possible.
# Typical: 5–10 depending on how dense your data is.
AI_BULK_BATCH_SIZE=10
# AI Mode 2 — Deep Search (ai_deep): thorough multi-angle investigation.
# Keep small (2–3) so the model digs properly per entity.
AI_DEEP_BATCH_SIZE=3

# ── 3b. Cleanup LLM (Phase 2) — which model cleans the raw responses ──
# Gemini is the ONLY provider (2026-08-20). AI_MODE_LLM_PROVIDER and the whole OPENAI_*
# family are deleted: the OpenAI-compatible transport had no tuned prompts and no pricing
# defaults, and LLM_BATCH=true already forced Gemini anyway, so the switch mostly existed
# to be set wrong.
# Gemini sync model (also used by SerpWow helpers). Optional.
GEMINI_MODEL=gemini-2.5-flash-lite
# Sync LLM call retries/timeout. Optional (defaults shown).
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120

# ── 3c. Cleanup engine: sync vs Gemini Batch API ──
# NOTE: this is AI Mode's OWN batch cleanup. It is NOT the SerpWow
# "Gemini batch postprocess" in section 4 — different feature, different knobs.
#   false (default) = normal per-batch synchronous cleanup, Gemini model from 3b.
#   true            = Gemini Batch API. Cheaper at large volume, but results arrive
#                     asynchronously. Requires GEMINI_API_KEY either way.
# ── THE batch toggle — and since 2026-08-20, the ONLY one ────────────
# One switch for every pipeline whose Gemini work can be batched: ai_bulk, ai_deep,
# gsearch, firmographics.
#   true  -> one Gemini Batch job per upload/run (~50% cheaper per token; results appear
#            only once the job lands)
#   false -> inline LLM calls, filled as each row/batch finishes
# relationship is ALWAYS batch -- its Gemini call is the verdict and there is no inline
# path -- and gmaps has no LLM at all. Neither reads this.
#
# The per-pipeline overrides AI_MODE_LLM_BATCH / GSEARCH_LLM_BATCH /
# FIRMOGRAPHICS_LLM_BATCH are DELETED: setting one now does NOTHING. They bought
# granularity nobody used and cost a second place to look when a run came out in the
# wrong mode -- the global only appeared to work because all three happened to be blank.
#
# Changing this needs a WORKER RESTART -- .env is read at process start.
LLM_BATCH=false
# Job shaping (only used when batching is on). Since 2026-08-19 these are the ONE set of
# batch knobs for ALL four pipelines — gsearch and firmographics used to read their own
# GSEARCH_GEMINI_CHUNK_SIZE / GSEARCH_GEMINI_MAX_INFLIGHT (same numbers, second names,
# now deleted). Optional.
# NOTE (operationally important): at the defaults, a 500k-row run is 500000/5000 = 100
# shards, processed 5 at a time = 20 SEQUENTIAL waves. Google's Batch API targets
# turnaround "within 24h" per job, not per shard — so at scale THIS phase, not the
# scraping, is the likely wall-clock bottleneck. Not yet measured at 500k; only inferred
# from the shard math and Google's documented SLA.
GEMINI_BATCH_SHARD_SIZE=5000   # requests per Gemini batch job (default 5000)
GEMINI_BATCH_MAX_INFLIGHT=5    # max concurrent Gemini batch jobs (default 5)
GEMINI_BATCH_POLL_SEC=15       # poll interval for ALL batch jobs (default 15)
# Per-run wait cap (default 172800 = 48h, the Gemini hard expiry).
# Now the SAME GEMINI_BATCH_TIMEOUT_SEC as every other pipeline (section 4).

# ── 3d. Scraping (Phase 1) — scrape.do tuning ──
# NOTE: AI Mode's scrape phase now runs through RabbitMQ (section 3f) in the
# WORKER process — scrape concurrency is AI_MODE_WORKER_CONCURRENCY there.
# SCRAPEDO_CONCURRENCY (defined near the bottom of this file) is NOT gone — only its old
# thread-pool meaning under the in-process sync engine is. It is now the per-ACCOUNT
# scrape.do semaphore shared by gmaps + AI Mode, and the relationship pipeline derives its
# in-flight row window from it, which makes it that pipeline's concurrency setting.
# Request tuning. All optional (defaults shown).
SCRAPEDO_TIMEOUT_SECONDS=90
# App-wide scrape.do retry knob: gmaps, AI Mode's scraper, AND (since the 2026-08
# relationship migration) the relationship pipeline's AI Mode client all share this ONE
# value. 2 -> 3 here means a 4th attempt for all three, not just relationship.
SCRAPEDO_MAX_RETRIES=3
SCRAPEDO_MAX_QUERY_CHARS=6000
# Locale/render knobs. All optional; empty = scrape.do defaults.
SCRAPEDO_DEVICE=
SCRAPEDO_HL=
# Country/geo targeting — hardcoded for all searches (per-row country derivation removed).
# SCRAPEDO_GL: 2-letter country code sent as the `gl` param to Google via scrape.do.
#   Default: us  Examples: in, gb, de, au, sg
# SCRAPEDO_GOOGLE_DOMAIN: override the Google domain. Default: google.com
#   Examples: google.co.in, google.co.uk, google.de
SCRAPEDO_GL=
SCRAPEDO_GOOGLE_DOMAIN=
SCRAPEDO_SAFE=
# Keep raw AI Mode HTML in run artifacts. Optional; default false.
SCRAPEDO_INCLUDE_HTML=false

# ── 3e. Cost tracking + logging ──
# scrape.do is billed as a flat fee, so it has NO per-run dollar cost — the run summary
# just counts searches done (scrapedo_searches). Only the LLM cleanup has a USD figure.
# LLM cost rates (USD per 1M tokens) for the run cost summary. Optional; 0 disables.
# The GEMINI_* pair is also used by the SerpWow legacy helpers.
GEMINI_INPUT_USD_PER_1M_TOKENS=0.10
GEMINI_OUTPUT_USD_PER_1M_TOKENS=0.40
# Gemini Batch pricing overrides (if batch pricing differs from sync). Optional.
GEMINI_BATCH_INPUT_USD_PER_1M_TOKENS=0.10
GEMINI_BATCH_OUTPUT_USD_PER_1M_TOKENS=0.40
# Per-run log verbosity for run.log (DEBUG|INFO|WARNING|ERROR). Optional; default INFO.
AI_MODE_LOG_LEVEL=INFO

# ── 3f. Broker engine (RabbitMQ) — how AI Mode runs execute ──
# AI Mode's scrape phase is queued through RabbitMQ (section 4's broker config)
# and consumed by the WORKER process (python worker.py) — the worker therefore
# needs SCRAPEDO_TOKEN, the LLM keys, and the S3/Supabase/Slack vars above
# (same-host deployments share this one .env). Uploads 503 when the broker is
# down. Exactly ONE worker process (the finish/reconciler task registry is
# in-process). All optional (defaults shown).
# Queue name + routing key on the shared exchange.
AI_MODE_QUEUE=ai_mode_jobs
AI_MODE_ROUTING_KEY=ai_mode.scrape
# Consumer loops AND per-channel prefetch = AI Mode scrape messages in flight.
# LEAVE UNSET to inherit WORKER_CONCURRENCY — that way a deployment sets ONE number.
# Set it only when AI Mode should differ from the SerpWow-engine pipelines: its
# messages are batches taking ~50s each, vs a gmaps row at ~3.5s.
# NOT a provider cap: concurrent scrape.do calls are bounded centrally by
# SCRAPEDO_CONCURRENCY, so raising this cannot breach the account limit.
# AI_MODE_WORKER_CONCURRENCY=
# Per-message processing timeout before nack/redelivery.
AI_MODE_JOB_TIMEOUT_SEC=600
# status.json flush throttle during scraping (counters only; files are truth).
AI_MODE_STATUS_FLUSH_SEC=2
# Reconciler: a publishing/scraping run with no new raw/error file for this long
# gets its missing batches republished (workers skip existing files)...
AI_MODE_BATCH_STALE_TIMEOUT_SEC=900
# ...at most this many times per batch, then the batch is terminalized as an
# error so the run always completes (resume clears markers and retries).
AI_MODE_BATCH_MAX_REQUEUE=1
# Newest N runs scanned per reconcile sweep.
AI_MODE_RECONCILE_SCAN_LIMIT=500
# Legacy (pre-broker) runs stuck queued/running longer than this are flipped to
# failed so the UI's "Rerun failed" button appears (phantom-running fix).
AI_MODE_LEGACY_STALE_SEC=3600
# final_report.json embeds the per-entity array only up to this many rows
# (above it, entities_omitted=true — found.csv/notFound.csv carry every row).
AI_MODE_REPORT_ENTITIES_MAX=50000

# ─────────────────────────────────────────────────────────────────────
# 4. SerpWow pipelines (gsearch only since 2026-08-19 — gmaps, relationship and
#    firmographics have all migrated to scrape.do; see section 5)
#    — only needed if you run these pipelines.
#    Requires RabbitMQ (docker-compose up -d) and an S3 bucket.
#    NOTE: the RabbitMQ broker below is now shared with AI Mode (section 3f).
# ─────────────────────────────────────────────────────────────────────
# SerpWow search API key — required for the SerpWow pipelines.
SERPWOW_API_KEY=
# Cost-summary rate: USD per SerpWow search/request (gsearch is per-request billed).
SERPWOW_USD_PER_SEARCH=0.00035

# RabbitMQ broker (docker-compose.yml provides one; user/pass default to guest/guest there).
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_VHOST=
RABBITMQ_EXCHANGE=
RABBITMQ_QUEUE=
RABBITMQ_ROUTING_KEY=

# S3 result storage. All pipelines (SerpWow + AI Mode) write
# <company>/<pipeline>/<run_id>/ under this bucket.
S3_BUCKET=website-url-finder
S3_REGION=ap-south-1
# AWS credentials are read implicitly by boto3's default credential chain
# (env vars, ~/.aws/credentials, instance profile, ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 client tuning. Optional.
S3_CONNECT_TIMEOUT_SEC=15
S3_READ_TIMEOUT_SEC=90
S3_MAX_RETRIES=3

# Worker tuning. Optional (defaults shown for WORKER_CONCURRENCY).
# WORKER_CONCURRENCY = worker SLOTS (RabbitMQ prefetch + consumer count) = rows in flight,
# NOT provider calls. Provider limits are separate and per-provider (see
# SEARCH_FETCH_CONCURRENCY and SCRAPEDO_CONCURRENCY), so raising this cannot exceed a
# vendor cap. For gmaps (1 scrape.do call per row) set it to your scrape.do concurrency.
# Requires a worker RESTART — consumers are created at startup.
# Caveat: all SerpWow pipelines share ONE queue, so a big gsearch run can occupy slots
# while throttled to SEARCH_FETCH_CONCURRENCY. Harmless, just idle slots.
WORKER_CONCURRENCY=4
ENABLE_VERBOSE_ROW_LOGS=true
# Industry-keyword fallback search pass. Optional; default true.
ENABLE_INDUSTRY_FALLBACK=true
# Max concurrent SerpWow API calls across the process (gsearch only — the other three
# pipelines are on scrape.do and share SCRAPEDO_CONCURRENCY instead).
# Per-PROVIDER, like SCRAPEDO_CONCURRENCY — independent of WORKER_CONCURRENCY.
SEARCH_FETCH_CONCURRENCY=5
# How often the SerpWow-engine state.json is mirrored to S3 during a run. It is re-PUT to
# the SAME key on every row update and grows with the run, so per-row mirroring uploads
# tens of MB of near-identical copies and hot-spots one key (the classic S3 SlowDown).
# Local disk is always written; only the S3 copy is throttled, and TERMINAL snapshots
# always mirror, so the final state is never stale. 0 disables the throttle.
SERPWOW_S3_STATE_FLUSH_SEC=5

# Gemini batch post-processing of finished upload result files. gsearch and firmographics,
# via LLM_BATCH (section 3c) — gmaps left this engine with its LLM modes in 2026-08.
# All FOUR pipelines share one batch driver and, since 2026-08-19, ONE set of config keys:
# GEMINI_BATCH_MODEL / GEMINI_BATCH_SHARD_SIZE / GEMINI_BATCH_MAX_INFLIGHT /
# GEMINI_BATCH_TIMEOUT_SEC / GEMINI_BATCH_POLL_SEC. The old duplicates
# (GSEARCH_GEMINI_CHUNK_SIZE, GSEARCH_GEMINI_MAX_INFLIGHT, RELATIONSHIP_BATCH_TIMEOUT_SEC)
# are DELETED -- they were second names for the same numbers. relationship's Gemini Batch
# verdict phase always runs; it has no toggle, since its Gemini call IS the verdict.
# Optional.
GEMINI_BATCH_MODEL=gemini-2.5-flash-lite
# Batch wait cap. ONE key for all four pipelines since 2026-08-19.
# 48h == Gemini's own job expiry. A Batch job runs and BILLS on Google's side whether
# or not we are still polling, so a shorter deadline abandons work already paid for.
GEMINI_BATCH_TIMEOUT_SEC=172800
# Durability: the worker periodically re-scans for in-flight Gemini batches and
# resumes polling them (so a server restart still finishes + notifies). Seconds.
GEMINI_BATCH_RECONCILE_INTERVAL_SEC=300

# gsearch (SerpWow Google AI Overview) confidence scoring
# Per-row Gemini confidence selection is ON by default. Set LLM_BATCH=true (section 3c)
# to defer scoring to a Gemini batch job at finalization instead (Phase 2).
ENABLE_FINAL_URL_GEMINI=true
# Always-on row terminalization reconciler (worker process).
GSEARCH_ROW_STALE_TIMEOUT_SEC=600   # a queued/processing row older than this is requeued/force-failed
GSEARCH_ROW_MAX_REQUEUE=1           # requeue attempts before force-fail

# gmaps runs on scrape.do's Google Maps API (NOT SerpWow) since 2026-08, so it needs
# SCRAPEDO_TOKEN (above) in BOTH the API and the worker env — an upload without it is
# rejected with 400. Billing is 10 credits per SUCCESSFUL call, one call per row, so
# gmaps reports
# scrapedo_requests/scrapedo_successful_requests/scrapedo_failed_requests/scrapedo_credits
# and no USD (SERPWOW_USD_PER_SEARCH does not apply to it).
#
# firmographics (Google Search, since 2026-08-19) bills TWO rates on the same account:
# 10 credits per /plugin/google/search HTTP 200, plus 5 more per
# /plugin/google/search/ai-overview follow-up, which fires only when Google reports the
# AI Overview as deferred. Reported as scrapedo_credits with a per-endpoint split
# (scrapedo_search_successful / scrapedo_ai_overview_successful); the only USD on a
# firmographics run is the Gemini normalisation call.
#
# SCRAPEDO_CONCURRENCY: max concurrent scrape.do calls across the WHOLE process — gmaps
# and AI Mode share this ONE gate, because scrape.do's cap is per ACCOUNT, not per
# pipeline (two separate limits could sum past it). Set it to your plan's concurrency.
# Mirrors SEARCH_FETCH_CONCURRENCY, which does the same for SerpWow. Note this is a
# CONCURRENCY cap, not a rate limit — if scrape.do also enforces requests/second, that
# belongs in provider_limits.scrapedo_slot() where every caller already passes through.
SCRAPEDO_CONCURRENCY=100
#
# It has NO gmaps-specific keys: SCRAPEDO_TIMEOUT_SECONDS and SCRAPEDO_MAX_RETRIES above
# are the single scrape.do timeout/retry knobs for the whole app (so changing them affects
# AI Mode and the relationship pipeline too). SCRAPEDO_MAX_RETRIES counts retries AFTER
# the first attempt: 3 => 4 calls per row. Failed calls are NOT billed, so a retry costs
# only latency. Backoff is
# exponential — 1s/2s/4s for 5xx, 5s/10s/20s for HTTP 429 (rate limits need real room) —
# a Retry-After header wins, and everything is capped at 30s.
# A 502 whose body says "no results" is NOT retried: that means Google has no Maps
# listing for the company, which is a business not-found, not a failure.

# gmaps confidence is HEURISTIC and has no knob: it is derived from Google-Maps
# name/address match signals at zero LLM cost. GMAPS_CONFIDENCE_MODE and GMAPS_LLM_BATCH
# are GONE (2026-08) — the batch one ran through the shared gsearch chunk engine, whose
# state lives in state.json, which is exactly what capped this pipeline at ~2.7k rows.
#
# gmaps is S3-only like relationship: no state.json, no local disk, one RabbitMQ message
# per RUN on the `gmaps_runs` queue, concurrency from the bounded task window inside the
# consumer (sized by SCRAPEDO_CONCURRENCY above — it has no concurrency knob of its own).
# How often the worker scans for gmaps runs that stopped progressing, and how old a run's
# last activity must be to count as stale. Same durability contract as relationship: the
# consumer acks its per-run message ON RECEIPT, so this scan is what recovers a worker
# that died, was down at publish time, or was replaced mid-run.
GMAPS_REDRIVE_SCAN_SEC=300
GMAPS_STALE_SEC=900
# How many times the re-drive scan may retry a gmaps run whose phase is "failed". A
# re-drive is free — every row with an S3 object is skipped — so one transient error must
# not park a long run permanently, but a genuinely broken run still has to stop.
GMAPS_MAX_DRIVE_ATTEMPTS=3

# --- Firmographics pipeline (scrape.do Google Search, S3-only since 2026-08-20) -------
# Enrich a KNOWN website with address/phone/email/industry/products/services. Same
# run-per-message model as gmaps and relationship (queue `firmographics_runs`, ack on
# receipt, bounded task window sized by SCRAPEDO_CONCURRENCY), so it has the same three
# durability knobs and no others. Its LLM pass is gated by LLM_BATCH (section 3c);
# everything else it needs — SCRAPEDO_*, GEMINI_*, S3_*, SUPABASE_*, SLACK_* — is shared.
FIRMOGRAPHICS_REDRIVE_SCAN_SEC=300
FIRMOGRAPHICS_STALE_SEC=900
FIRMOGRAPHICS_MAX_DRIVE_ATTEMPTS=3

# --- Relationship pipeline (scrape.do Google AI Mode, since 2026-08) -----------------
# X<->Y financial relationship + Y's website, gated on the relationship being confirmed.
# S3-only (no state.json, no local disk — object presence IS the state), one RabbitMQ
# message per RUN, concurrency from a bounded task window inside the consumer. Needs
# SCRAPEDO_TOKEN (above) same as gmaps/AI Mode. The old per-pipeline RELATIONSHIP_LLM_BATCH
# gate was removed with the SerpWow row path — the Gemini Batch verdict phase now always
# runs (see GEMINI_BATCH_SHARD_SIZE/GEMINI_BATCH_MAX_INFLIGHT above).
#
# CONCURRENCY: this pipeline has NO knob of its own. Its in-flight row count is derived
# from SCRAPEDO_CONCURRENCY (above, default 100) — the per-ACCOUNT vendor cap it shares
# with gmaps and AI Mode. A second setting could only disagree with the real limit, since
# every call already passes through the same semaphore. Note WORKER_CONCURRENCY does not
# apply here either: it sets RabbitMQ prefetch, and this pipeline has one message per run.
# 100 is a TARGET, not a measurement: on the gmaps Maps endpoint 100 ran 1.9x SLOWER than
# 25 because scrape.do queues instead of 429ing. Re-measure on a live run.
#
# status.json counter flush interval (seconds). It is a cache only; the S3 objects
# (raw/.../row_NNNNNN.json, cleaned/...) are the source of truth.
RELATIONSHIP_STATUS_FLUSH_SEC=2
# The search prompt is backend/app/prompts/relationship_search.txt — a fixed filename, as
# with AI Mode's own prompts. Tune it by editing that file; no code change and no env var
# is involved. It is cached per process, so a running worker needs a RESTART to pick up an
# edit.
# How often the worker scans for runs that stopped progressing (seconds), and how old a
# run's last activity must be to count as stale (seconds). This scan is the pipeline's
# durability mechanism: the consumer acks its per-run message ON RECEIPT (the repo's only
# ack-before-persist inversion) because a held message would hit RabbitMQ's 30-minute
# consumer_timeout on a multi-hour run, so redrive_stale_runs covers a worker that died,
# was down at publish time, or was replaced mid-run.
RELATIONSHIP_REDRIVE_SCAN_SEC=300
RELATIONSHIP_STALE_SEC=900

# How long to keep polling ONE Gemini Batch verdict shard. Its OWN key, deliberately not
# the shared GEMINI_BATCH_TIMEOUT_SEC (which bounds gsearch's per-row batches and is set
# to 1800 above) — the Batch API targets "within 24h PER JOB", so 30 minutes would abandon
# every shard of a large run. 172800 = 48h = Gemini's own job expiry, past which the job
# cannot succeed. A shard's job name is persisted to <run>/batches/, so a timeout or a
# worker restart RE-ATTACHES to the running job on the next drive instead of paying for a
# second identical batch.
# RELATIONSHIP_BATCH_TIMEOUT_SEC deleted 2026-08-19: relationship now shares
# GEMINI_BATCH_TIMEOUT_SEC with the other three (both were 48h in practice).

# How many times the re-drive scan may retry a run whose phase is "failed" (drive_run hit
# an exception). A re-drive is free — every row that already has an S3 object is skipped —
# so one transient error should not park a multi-day run permanently. Bounded so a
# genuinely broken run still stops instead of looping.
RELATIONSHIP_MAX_DRIVE_ATTEMPTS=3

# Gemini URL/city-state reasoning switches. Optional; default true.
ENABLE_GMAPS_FALLBACK=true

# Worker/S3 stability knobs. Optional.
WORKER_JOB_TIMEOUT_SEC=1800
PROCESSING_STALE_TIMEOUT_SEC=1500
ORPHAN_UPLOAD_FINALIZE_TIMEOUT_SEC=1800
ENABLE_ORPHAN_UPLOAD_FINALIZER=false
ENABLE_STALE_PROCESSING_FINALIZER=false

# ─────────────────────────────────────────────────────────────────────
# 5. Slack notifications (optional)
# ─────────────────────────────────────────────────────────────────────
# Slack Incoming Webhook URL. When set, both pipelines (AI Mode + SerpWow)
# post a plain-text message when a run COMPLETES or FAILS. Unset = disabled
# (best-effort; a Slack outage never affects a run).
SLACK_WEBHOOK_URL=
