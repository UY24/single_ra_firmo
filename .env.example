# =====================================================================
# website_url_finder — environment configuration
# Copy to .env and fill the REQUIRED section first.
# Every key below is actually read by backend/ code (audited 2026-06).
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# 1. REQUIRED — core
# ─────────────────────────────────────────────────────────────────────
# HTTP bind address + port for the FastAPI app (UI at /app). Optional; defaults 0.0.0.0:11500.
API_HOST=0.0.0.0
API_PORT=8080
# Uvicorn dev knobs (only used when launching via `python -m app.main` / run.py).
# Optional. API_RELOAD=true enables auto-reload on code change; default false.
API_RELOAD=false
UVICORN_LOG_LEVEL=info

# scrape.do API token — REQUIRED for AI Mode (ai_bulk / ai_deep Phase 1 scraping).
SCRAPEDO_TOKEN=

# At least ONE LLM key is REQUIRED.
# Gemini is the default provider (AI Mode cleanup + SerpWow Gemini helpers).
GEMINI_API_KEY=
# OpenAI is the alternative for AI Mode sync cleanup — see the AI Mode section below.

# ─────────────────────────────────────────────────────────────────────
# 2. Supabase (company/run tracking) — REQUIRED for the UI workflows
# ─────────────────────────────────────────────────────────────────────
# SUPABASE_URL must be the BARE project URL, e.g. https://xyz.supabase.co
# NOT the postgres connection string (postgresql://...:5432/...).
SUPABASE_URL=
# The service_role secret (~200+ chars JWT) from Project Settings → API.
# Server-side only — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────
# 3. AI Mode (scrape.do Google AI Mode + LLM cleanup)
# ─────────────────────────────────────────────────────────────────────
# Phase-2 cleanup provider: gemini (uses GEMINI_API_KEY/GEMINI_MODEL) or openai.
# Optional; default gemini.
AI_MODE_LLM_PROVIDER=gemini
# Default Gemini model for sync LLM cleanup + SerpWow helpers. Optional.
GEMINI_MODEL=gemini-2.5-flash-lite
# OpenAI settings (only needed when AI_MODE_LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional override for OpenAI-compatible endpoints; default https://api.openai.com/v1.
OPENAI_BASE_URL=

# Per-mode batch sizes: ai_bulk = entities per scrape.do prompt (high throughput, default 10),
# ai_deep = smaller batches for the deep-search prompt (default 3). Optional.
AI_BULK_BATCH_SIZE=10
AI_DEEP_BATCH_SIZE=3

# Phase-2 cleanup mode. Optional; default false.
#   true  = Gemini Batch API ONLY (forces the gemini provider regardless of
#           AI_MODE_LLM_PROVIDER; requires GEMINI_API_KEY).
#   false = normal per-batch synchronous cleanup with whichever provider
#           AI_MODE_LLM_PROVIDER selects.
AI_MODE_LLM_BATCH=false
# Parallel scrape.do workers in Phase 1. Optional; default 5.
# Can be raised toward the ~100-concurrency scrape.do plan cap.
SCRAPEDO_CONCURRENCY=5
# Gemini Batch API job shaping (used only when AI_MODE_LLM_BATCH=true). Optional.
GEMINI_BATCH_SHARD_SIZE=5000   # requests per Gemini batch job (default 5000)
GEMINI_BATCH_MAX_INFLIGHT=5    # max concurrent Gemini batch jobs (default 5)
AI_MODE_BATCH_POLL_SEC=15      # poll interval for AI Mode batch jobs (default 15)
# Per-run wait cap for AI Mode batch (default 172800 = 48h, the Gemini hard expiry).
# Separate from SerpWow's GEMINI_BATCH_TIMEOUT_SEC below.
AI_MODE_BATCH_TIMEOUT_SEC=172800

# Per-run log verbosity for run.log (DEBUG|INFO|WARNING|ERROR). Optional; default INFO.
AI_MODE_LOG_LEVEL=INFO

# USD per scrape.do request for the run cost summary (plan price / monthly request quota).
# Optional; 0 (default) disables the USD estimate — per-request credit costs from
# response headers are still recorded.
SCRAPEDO_COST_PER_REQUEST_USD=0
# LLM cost rates (USD per 1M tokens) for the run cost summary. Optional; 0 disables.
# The GEMINI_* pair is also used by the SerpWow legacy helpers.
GEMINI_INPUT_USD_PER_1M_TOKENS=0.10
GEMINI_OUTPUT_USD_PER_1M_TOKENS=0.40
# Gemini Batch pricing overrides (if batch pricing differs from sync). Optional.
GEMINI_BATCH_INPUT_USD_PER_1M_TOKENS=0.10
GEMINI_BATCH_OUTPUT_USD_PER_1M_TOKENS=0.40
OPENAI_INPUT_USD_PER_1M_TOKENS=0
OPENAI_OUTPUT_USD_PER_1M_TOKENS=0

# scrape.do request tuning. All optional (defaults shown).
SCRAPEDO_TIMEOUT_SECONDS=90
SCRAPEDO_MAX_RETRIES=2
SCRAPEDO_MAX_QUERY_CHARS=6000
# scrape.do locale/render knobs. Optional; empty = scrape.do defaults.
SCRAPEDO_DEVICE=
SCRAPEDO_HL=
SCRAPEDO_GL=
SCRAPEDO_GOOGLE_DOMAIN=
SCRAPEDO_SAFE=
# Keep raw AI Mode HTML in run artifacts. Optional; default false.
SCRAPEDO_INCLUDE_HTML=false
# Sync LLM call retries/timeout. Optional (defaults shown).
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120

# ─────────────────────────────────────────────────────────────────────
# 4. SerpWow pipelines (legacy: full / url_discovery / firmographics /
#    gmaps / gsearch) — only needed if you run these pipelines.
#    Requires RabbitMQ (docker-compose up -d) and an S3 bucket.
# ─────────────────────────────────────────────────────────────────────
# SerpWow search API key — required for the SerpWow pipelines.
SERPWOW_API_KEY=
# Cost-summary rates (USD per SerpWow search/request). Optional.
SERPWOW_USD_PER_SEARCH=0.00035
SERPWOW_USD_PER_REQUEST=0.00035

# RabbitMQ broker (docker-compose.yml provides one; user/pass default to guest/guest there).
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_VHOST=
RABBITMQ_EXCHANGE=
RABBITMQ_QUEUE=
RABBITMQ_ROUTING_KEY=

# S3 result storage. S3_BUCKET is required for these pipelines.
S3_BUCKET=
S3_REGION=
# AWS credentials are read implicitly by boto3's default credential chain
# (env vars, ~/.aws/credentials, instance profile, ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 client tuning. Optional.
S3_CONNECT_TIMEOUT_SEC=15
S3_READ_TIMEOUT_SEC=90
S3_MAX_RETRIES=3

# Worker tuning. Optional (defaults shown for WORKER_CONCURRENCY).
WORKER_CONCURRENCY=4
ENABLE_VERBOSE_ROW_LOGS=true
# Industry-keyword fallback search pass. Optional; default true.
ENABLE_INDUSTRY_FALLBACK=true
# Concurrent page fetches during search verification. Optional.
SEARCH_FETCH_CONCURRENCY=5

# Gemini batch post-processing of finished result files. Optional.
ENABLE_GEMINI_BATCH_POSTPROCESS=true
GEMINI_BATCH_MODEL=gemini-2.5-flash-lite
GEMINI_BATCH_POLL_SEC=15
# SerpWow batch wait cap (separate from AI_MODE_BATCH_TIMEOUT_SEC above).
GEMINI_BATCH_TIMEOUT_SEC=1800

# Gemini URL/city-state reasoning switches. Optional; default true.
ENABLE_FINAL_URL_GEMINI=true
ENABLE_GMAPS_FALLBACK=true

# Worker/S3 stability knobs. Optional.
WORKER_JOB_TIMEOUT_SEC=1800
PROCESSING_STALE_TIMEOUT_SEC=1500
ORPHAN_UPLOAD_FINALIZE_TIMEOUT_SEC=1800
ENABLE_ORPHAN_UPLOAD_FINALIZER=false
ENABLE_STALE_PROCESSING_FINALIZER=false

# ─────────────────────────────────────────────────────────────────────
# 5. Deprecated / optional fallbacks
# ─────────────────────────────────────────────────────────────────────
# DEPRECATED: still read as the ai_bulk batch-size fallback when
# AI_BULK_BATCH_SIZE is unset; prefer the per-mode keys above.
SCRAPEDO_BATCH_SIZE=10
